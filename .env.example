# Ghostline environment variables.
# Copy this file to .env.local and fill in the keys you need.
# Never commit .env.local. Never print a key in a log.

# Postgres connection string (Neon free tier). If this is empty or the
# database cannot be reached, Ghostline falls back to a local JSON file
# store in data/ghostline.json, so the app still runs end to end.
DATABASE_URL=

# OpenAI key for Whisper transcription. Needed for voice notes.
OPENAI_API_KEY=

# Anthropic key for the interview agent and the draft engine.
# Optional: pick the Claude model. Defaults to claude-sonnet-4-5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
